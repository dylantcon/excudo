<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Presentation Explorer panel: slide-hierarchy tree + CRUD toolbar.
  Consumed as the left side of the main SplitPane via fx:include.
  Controller owns all @FXML injection + event wiring.
-->
<VBox fx:id="leftPanel"
      xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.excudo.view.components.PresentationExplorerController"
      spacing="5.0">
   <Label text="Presentation Explorer" />
   <TreeView fx:id="presentationTree" VBox.vgrow="ALWAYS" />
   <Label fx:id="presentationInfo" text="No presentation loaded" wrapText="true" />
   <!--
     No Refresh button: the explorer subscribes to
     SessionManager.addStateListener on construction and auto-refreshes
     on every mutation (via OrchestrationStateListener). If the tree
     ever goes stale the fix is the listener, not a user-triggered
     refresh — that was a symptom-papering button, not a feature.
   -->
   <FlowPane hgap="5.0" vgap="5.0">
      <Button fx:id="addSlideButton" text="Add" />
      <Button fx:id="deleteSlideButton" text="Delete" />
      <Button fx:id="moveUpButton" text="Up" />
      <Button fx:id="moveDownButton" text="Down" />
   </FlowPane>
</VBox>
