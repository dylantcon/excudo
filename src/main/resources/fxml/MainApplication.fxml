<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.excudo.view.MainController">
   <top>
      <VBox>
         <MenuBar fx:id="menuBar">
            <Menu text="File">
               <MenuItem fx:id="newPresentationItem" text="New Presentation" />
               <MenuItem fx:id="openPresentationItem" text="Open Presentation..." />
               <SeparatorMenuItem />
               <MenuItem fx:id="savePresentationItem" text="Save Presentation" />
               <MenuItem fx:id="saveAsPresentationItem" text="Save As..." />
               <MenuItem fx:id="exportPresentationItem" text="Export..." />
               <SeparatorMenuItem />
               <MenuItem fx:id="exitItem" text="Exit" />
            </Menu>
            <Menu text="Edit">
               <MenuItem fx:id="undoMenuItem" text="Undo" accelerator="Shortcut+Z" />
               <MenuItem fx:id="redoMenuItem" text="Redo" accelerator="Shortcut+Shift+Z" />
            </Menu>
            <Menu text="View">
               <CheckMenuItem fx:id="showGridItem" text="Show Grid" />
               <CheckMenuItem fx:id="showBoundsItem" text="Show Bounds" />
               <CheckMenuItem fx:id="showSpidsItem" text="Show SPIDs" />
               <SeparatorMenuItem />
               <CheckMenuItem fx:id="debugModeItem" text="Debug Mode" />
               <SeparatorMenuItem />
               <Menu text="Zoom">
                  <MenuItem fx:id="zoomInMenuItem" text="Zoom In" accelerator="Shortcut+Plus" />
                  <MenuItem fx:id="zoomOutMenuItem" text="Zoom Out" accelerator="Shortcut+Minus" />
                  <MenuItem fx:id="zoomFitMenuItem" text="Zoom Fit" accelerator="Shortcut+0" />
                  <MenuItem fx:id="zoom100MenuItem" text="Zoom 100%" accelerator="Shortcut+1" />
               </Menu>
            </Menu>
            <Menu text="Tools">
               <MenuItem fx:id="validatePresentationItem" text="Validate Presentation" />
               <MenuItem fx:id="regenerateSpidsItem" text="Regenerate SPIDs" />
               <SeparatorMenuItem />
               <MenuItem fx:id="settingsItem" text="Settings..." />
            </Menu>
         </MenuBar>
         <ToolBar fx:id="toolBar">
            <Button fx:id="newButton" text="New" />
            <Button fx:id="openButton" text="Open" />
            <Button fx:id="saveButton" text="Save" />
            <Separator />
            <Button fx:id="zoomInButton" text="Zoom In" />
            <Button fx:id="zoomOutButton" text="Zoom Out" />
            <Button fx:id="zoomFitButton" text="Zoom Fit" />
         </ToolBar>
      </VBox>
   </top>
   <center>
      <VBox fx:id="centerStack" spacing="0.0">
         <!-- Session tabs: one per active presentation, + for new. -->
         <HBox fx:id="sessionTabBar" spacing="4.0" style="-fx-padding: 4 8; -fx-background-color: #2a2a2a;">
            <TabPane fx:id="sessionTabPane" tabClosingPolicy="SELECTED_TAB" HBox.hgrow="ALWAYS" minHeight="28.0" />
            <Button fx:id="newSessionButton" text="+" style="-fx-min-width: 28;" />
         </HBox>
      <SplitPane fx:id="mainSplitPane" dividerPositions="0.2" VBox.vgrow="ALWAYS">
         <!-- Left Panel: Presentation Explorer -->
         <VBox fx:id="leftPanel" spacing="5.0">
            <Label text="Presentation Explorer" />
            <TreeView fx:id="presentationTree" VBox.vgrow="ALWAYS" />
            <Label fx:id="presentationInfo" text="No presentation loaded" wrapText="true" />
            <FlowPane hgap="5.0" vgap="5.0">
               <Button fx:id="addSlideButton" text="Add" />
               <Button fx:id="deleteSlideButton" text="Delete" />
               <Button fx:id="moveUpButton" text="Up" />
               <Button fx:id="moveDownButton" text="Down" />
               <Button fx:id="refreshButton" text="Refresh" />
            </FlowPane>
         </VBox>

         <!-- Center Panel: Main Content with Bottom Dock -->
         <SplitPane fx:id="centerRightSplit" dividerPositions="0.65" orientation="VERTICAL">
            <!-- Center: Slide Preview -->
            <VBox fx:id="centerPanel" spacing="0.0">
               <HBox spacing="8.0" alignment="CENTER_LEFT" style="-fx-padding: 4 8; -fx-background-color: #2d2d2d;">
                  <Label text="Slide Preview" style="-fx-text-fill: #cccccc; -fx-font-size: 11px;" />
               </HBox>
               <ScrollPane fx:id="canvasScrollPane" VBox.vgrow="ALWAYS"
                           fitToWidth="true" fitToHeight="true"
                           style="-fx-background-color: #3c3c3c;">
                  <!-- Canvas will be added programmatically -->
               </ScrollPane>
            </VBox>

            <!-- Bottom Dock: Console + Properties side-by-side.
                 TabPane hosts both; tab switching avoids cramping the
                 bottom dock vertically when both are visible. -->
            <TabPane fx:id="bottomTabPane" minHeight="150.0">
               <Tab fx:id="consoleTab" closable="false" text="Console">
                  <VBox spacing="5.0">
                     <ScrollPane fx:id="consoleScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: #1e1e1e;">
                        <TextFlow fx:id="consoleOutput" styleClass="console-output" />
                     </ScrollPane>
                     <HBox spacing="5.0">
                        <TextField fx:id="commandInput" HBox.hgrow="ALWAYS" />
                        <Button fx:id="executeButton" text="Execute" />
                     </HBox>
                  </VBox>
               </Tab>
               <Tab fx:id="propertiesTab" closable="false" text="Properties">
                  <VBox fx:id="propertiesPanel" spacing="5.0" style="-fx-padding: 5px;">
                     <Label fx:id="propertiesTitle" text="Properties" style="-fx-font-weight: bold;" />
                     <TableView fx:id="propertiesTable" VBox.vgrow="ALWAYS" />
                     <HBox spacing="5.0">
                        <Button fx:id="refreshPropertiesButton" text="Refresh" />
                     </HBox>
                  </VBox>
               </Tab>
            </TabPane>
         </SplitPane>
      </SplitPane>
      </VBox>
   </center>
   <bottom>
      <Label fx:id="statusBar" style="-fx-background-color: #f0f0f0; -fx-padding: 5px;" text="Ready" />
   </bottom>
</BorderPane>