<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.excudo.view.MainController">
   <top>
      <VBox>
         <MenuBar fx:id="menuBar">
            <Menu text="File">
               <MenuItem fx:id="newPresentationItem" text="New Presentation" />
               <MenuItem fx:id="openPresentationItem" text="Open Presentation..." />
               <SeparatorMenuItem />
               <MenuItem fx:id="savePresentationItem" text="Save Presentation" />
               <MenuItem fx:id="saveAsPresentationItem" text="Save As..." />
               <MenuItem fx:id="exportPresentationItem" text="Export..." />
               <SeparatorMenuItem />
               <MenuItem fx:id="exitItem" text="Exit" />
            </Menu>
            <Menu text="Edit">
               <MenuItem fx:id="undoMenuItem" text="Undo" accelerator="Shortcut+Z" />
               <MenuItem fx:id="redoMenuItem" text="Redo" accelerator="Shortcut+Shift+Z" />
            </Menu>
            <Menu text="View">
               <CheckMenuItem fx:id="showGridItem" text="Show Grid" />
               <CheckMenuItem fx:id="showBoundsItem" text="Show Bounds" />
               <CheckMenuItem fx:id="showSpidsItem" text="Show SPIDs" />
               <SeparatorMenuItem />
               <CheckMenuItem fx:id="debugModeItem" text="Debug Mode" />
               <SeparatorMenuItem />
               <Menu text="Zoom">
                  <MenuItem fx:id="zoomInMenuItem" text="Zoom In" accelerator="Shortcut+Plus" />
                  <MenuItem fx:id="zoomOutMenuItem" text="Zoom Out" accelerator="Shortcut+Minus" />
                  <MenuItem fx:id="zoomFitMenuItem" text="Zoom Fit" accelerator="Shortcut+0" />
                  <MenuItem fx:id="zoom100MenuItem" text="Zoom 100%" accelerator="Shortcut+1" />
               </Menu>
            </Menu>
            <Menu text="Tools">
               <MenuItem fx:id="validatePresentationItem" text="Validate Presentation" />
               <MenuItem fx:id="regenerateSpidsItem" text="Regenerate SPIDs" />
               <SeparatorMenuItem />
               <MenuItem fx:id="settingsItem" text="Settings..." />
            </Menu>
         </MenuBar>
         <ToolBar fx:id="toolBar">
            <Button fx:id="newButton" text="New" />
            <Button fx:id="openButton" text="Open" />
            <Button fx:id="saveButton" text="Save" />
            <Separator />
            <Button fx:id="zoomInButton" text="Zoom In" />
            <Button fx:id="zoomOutButton" text="Zoom Out" />
            <Button fx:id="zoomFitButton" text="Zoom Fit" />
         </ToolBar>
      </VBox>
   </top>
   <center>
      <VBox fx:id="centerStack" spacing="0.0">
         <!-- Session tabs (fx:include -> panels/SessionTabBar.fxml) -->
         <fx:include fx:id="sessionTabBarInclude" source="panels/SessionTabBar.fxml" />
      <SplitPane fx:id="mainSplitPane" dividerPositions="0.2,0.75" VBox.vgrow="ALWAYS">
         <!-- Left Panel: Presentation Explorer (fx:include -> panels/PresentationExplorer.fxml) -->
         <fx:include fx:id="presentationExplorerInclude" source="panels/PresentationExplorer.fxml" />

         <!-- Center Panel: Canvas above, Console + Properties dock below -->
         <SplitPane fx:id="centerRightSplit" dividerPositions="0.65" orientation="VERTICAL">
            <!-- Center: Slide Preview (fx:include -> panels/SlideCanvas.fxml) -->
            <fx:include fx:id="slideCanvasInclude" source="panels/SlideCanvas.fxml" />

            <!-- Bottom Dock: Console + Properties side-by-side.
                 SlideSpec used to live here as a third tab; it's been
                 promoted to a persistent RHS aside (below) so the
                 synthesized script is always visible while editing. -->
            <TabPane fx:id="bottomTabPane" minHeight="150.0">
               <Tab fx:id="consoleTab" closable="false" text="Console">
                  <fx:include fx:id="consoleInclude" source="panels/Console.fxml" />
               </Tab>
               <Tab fx:id="propertiesTab" closable="false" text="Properties">
                  <fx:include fx:id="propertiesInclude" source="panels/Properties.fxml" />
               </Tab>
            </TabPane>
         </SplitPane>

         <!-- Right Panel: SlideSpec aside (fx:include -> panels/SlideSpec.fxml).
              Persistent view of the synthesized command script for the
              active slide. Follows the active slide selection. -->
         <fx:include fx:id="slideSpecInclude" source="panels/SlideSpec.fxml" />
      </SplitPane>
      </VBox>
   </center>
   <bottom>
      <Label fx:id="statusBar" style="-fx-background-color: #f0f0f0; -fx-padding: 5px;" text="Ready" />
   </bottom>
</BorderPane>