# Presentation Choreographer Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic Claude API for LLM functionality
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Freepik API for premium icon access (10M+ icons)
# Get your API key from: https://www.freepik.com/api
FREEPIK_API_KEY=your_freepik_api_key_here

# Optional: Set to true to disable API calls (local icons only)
# OFFLINE_MODE=false